<Window x:Class="VNPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VN PC — відеоредактор" Width="1280" Height="800" MinWidth="980" MinHeight="620"
        Background="#111114" Foreground="White"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="240"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель -->
        <DockPanel Grid.Row="0" Background="#1A1A20" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <Button Content="＋ Імпорт" Click="BtnImport_Click"/>
                <Button Content="✂ Розрізати (S)" Click="BtnSplit_Click"/>
                <Button Content="Видалити (Del)" Click="BtnDelete_Click"/>
                <Button Content="◀" ToolTip="Посунути кліп ліворуч" Click="BtnMoveLeft_Click"/>
                <Button Content="▶" ToolTip="Посунути кліп праворуч" Click="BtnMoveRight_Click"/>
                <TextBlock Text="Швидкість" VerticalAlignment="Center" Margin="14,0,4,0" Foreground="#9AA"/>
                <ComboBox x:Name="CmbSpeed" Width="72" SelectionChanged="CmbSpeed_Changed" DropDownClosed="Combo_Closed"/>
                <TextBlock Text="Гучність" VerticalAlignment="Center" Margin="14,0,4,0" Foreground="#9AA"/>
                <Slider x:Name="SldVolume" Width="100" Minimum="0" Maximum="2" Value="1"
                        VerticalAlignment="Center" Focusable="False" ValueChanged="SldVolume_Changed"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <ComboBox x:Name="CmbRatio" Width="76" SelectionChanged="CmbRatio_Changed" DropDownClosed="Combo_Closed"/>
                <ComboBox x:Name="CmbRes" Width="80" DropDownClosed="Combo_Closed"/>
                <CheckBox x:Name="ChkHw" Content="Intel QSV" IsChecked="True" Focusable="False"
                          ToolTip="Апаратне кодування відеокартою Intel. Якщо не спрацює — автоматично програмне."/>
                <Button x:Name="BtnExport" Style="{StaticResource AccentButton}" Content="Експорт" Click="BtnExport_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Медіатека + перегляд -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#16161B" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Медіатека" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Button DockPanel.Dock="Bottom" Content="На доріжку" Margin="0,8,0,0" Click="BtnAddToTimeline_Click"/>
                    <ListBox x:Name="LstMedia" Background="Transparent" BorderThickness="0" Foreground="White"
                             MouseDoubleClick="LstMedia_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Info}" Foreground="#9AA" FontSize="11"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#18C7A0" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="48"/>
                </Grid.RowDefinitions>

                <Grid x:Name="PreviewHost" Background="Black" ClipToBounds="True" SizeChanged="PreviewHost_SizeChanged">
                    <Border x:Name="PreviewFrame" Background="Black" Width="640" Height="360"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      ScrubbingEnabled="True" Stretch="Uniform"
                                      MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                                      MediaFailed="Player_MediaFailed"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="⏮" Click="BtnToStart_Click"/>
                    <Button x:Name="BtnPlay" Content="▶ Грати" Width="100" Click="BtnPlay_Click"/>
                    <TextBlock x:Name="TimeText" Text="0:00.0 / 0:00.0" VerticalAlignment="Center"
                               Margin="14,0" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Доріжка -->
        <Border Grid.Row="2" Background="#16161B" BorderBrush="#26262E" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="30" Margin="8,0">
                    <TextBlock Text="Масштаб" VerticalAlignment="Center" Foreground="#9AA" Margin="0,0,8,0"/>
                    <Slider x:Name="SldZoom" Width="160" Minimum="10" Maximum="300" Value="60"
                            VerticalAlignment="Center" Focusable="False" ValueChanged="SldZoom_Changed"/>
                </StackPanel>
                <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <Canvas x:Name="TimelineCanvas" Height="170" Background="#1B1B21" ClipToBounds="True"
                            MouseLeftButtonDown="Timeline_Down" MouseMove="Timeline_Move"
                            MouseLeftButtonUp="Timeline_Up"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Статус -->
        <DockPanel Grid.Row="3" Background="#0D0D10">
            <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="Скасувати" Padding="8,0"
                    Visibility="Collapsed" Click="BtnCancel_Click"/>
            <ProgressBar x:Name="ExportProgress" DockPanel.Dock="Right" Width="220" Height="12" Margin="8,0"
                         Minimum="0" Maximum="1" Visibility="Collapsed" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Margin="10,0" VerticalAlignment="Center" Foreground="#9AA" Text="Готово"/>
        </DockPanel>
    </Grid>
</Window>
